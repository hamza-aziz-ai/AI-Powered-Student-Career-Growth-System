# Copy to .env and fill in real values. Never commit .env.

# Any value other than "development" enables Secure cookies, hides /docs, and requires a real JWT_SECRET_KEY.
ENVIRONMENT=development

# Uses a locally installed PostgreSQL server (not Docker, for now).
# Create the app role/database once via psql as your postgres superuser:
#   CREATE USER career_growth_app WITH PASSWORD 'your-password-here';
#   CREATE DATABASE career_growth OWNER career_growth_app;
#   CREATE DATABASE career_growth_test OWNER career_growth_app;  -- used by pytest
DATABASE_URL=postgresql+asyncpg://career_growth_app:your-password-here@localhost:5432/career_growth

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Ollama must already be running locally (ollama serve) with the model pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_TIMEOUT_SECONDS=90

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173
